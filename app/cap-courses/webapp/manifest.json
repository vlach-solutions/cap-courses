{
  "_version": "1.90.0",
  "sap.app": {
    "id": "capcourses",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.34.0",
      "toolsId": "0abbe004-5868-4521-8d24-223a47b65ee0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/courseservice/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.154.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "capcourses.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "CourseList",
          "target": "CourseList"
        },
        {
          "pattern": "Course({key}):?query:",
          "name": "CourseObjectPage",
          "target": "CourseObjectPage"
        },
        {
          "pattern": "Course({key})/buchungen({key2}):?query:",
          "name": "BookingsObjectPage",
          "target": "BookingsObjectPage"
        }
      ],
      "targets": {
        "CourseList": {
          "type": "Component",
          "id": "CourseList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Course",
              "variantManagement": "Page",
              "navigation": {
                "Course": {
                  "detail": {
                    "route": "CourseObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "CourseObjectPage": {
          "type": "Component",
          "id": "CourseObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Course",
              "navigation": {
                "buchungen": {
                  "detail": {
                    "route": "BookingsObjectPage"
                  }
                }
              }
            }
          }
        },
        "BookingsObjectPage": {
          "type": "Component",
          "id": "BookingsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Course/buchungen"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.cloud": {
      "public": true,
  "service": "capcourses"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
